# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB Atlas ---
# Replace <user>, <password>, <cluster> with your Atlas credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blyart?retryWrites=true&w=majority

# --- JWT auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
